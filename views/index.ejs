
<link rel="stylesheet" href="/css/index.css">
<script src="/js/index.js"></script>

<div class="container">
    <div class="card">
        <div class="logo">
            <i class="fas fa-lock"></i>
        </div>
        <h1>Private File Sharing</h1>
        <p class="subtitle">Enter your password to access the upload interface.<br/>This platform is exclusively for authorized users.</p>

        <div class="password-container">
            <input type="password" class="password-input" id="password" placeholder="Enter your access password">
            <span class="toggle-password" id="togglePassword">
                <i class="far fa-eye"></i>
            </span>
        </div>

        <button class="btn" id="submitPassword">Login</button>
    </div>
</div>